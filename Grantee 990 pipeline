"""
GRANTEE 990 + RULE 1-3 COMPLIANCE ANALYSIS -- combined pipeline

For every organization in "Quarterly Grantee Tax-Exempt Check.xlsx", this:
  1. Opens the org's page on https://projects.propublica.org/nonprofits/
  2. Finds the most recent Form 990 filing
  3. Pulls Total Revenue and the filing year (plain HTML, no browser needed)
  4. Opens the "Full Filing" reconstructed-document view, switches to
     "Form 990, Schedule A" (requires a real headless browser -- that page
     fills in its numbers with JavaScript after loading)
  5. Reads Total Public Support and Public Support Percentage from Schedule A
  6. Applies Legal's three review rules to each org
  7. Writes ONE formatted Excel file with everything

RULES (per Legal's guidance):
  Rule 1 (primary): 2026 Grant Budget / Total Revenue should not exceed 35%.
  Rule 2 (supporting): Public Support Percentage below 75% -> additional review.
  Rule 3 (supporting): 2026 Grant Budget / Public Support Amount over 50%
    -> additional review.
  An org that PASSES Rule 1 is generally considered allowable even if Rule 2
  or 3 flags -- Rule 1 alone drives "Needs Legal Review"; Rule 2/3 alone
  drives a lighter "Additional Review" status.

OUTPUT COLUMNS (letters match Legal's existing template):
    A: Organization Name       I: Grant / Revenue (D/G)
    B: Form 990 Year Used      J: Rule 1 Flag (>35%)
    C: Portfolio Strategy      K: Rule 2 Flag (Public Support <75%)
       (blank -- manual entry) L: Public Support Percentage
    D: 2026 Grant Budget       M: Rule 3 Flag (Grant/Support >50%)
    E: EIN                     N: Grant / Public Support (D/H)
    F: Filing Link             O: Overall Status
    G: Total Revenue           P: Notes
    H: Public Support Amount

SETUP (run once per environment):
    pip install requests pandas beautifulsoup4 playwright openpyxl
    playwright install chromium
    playwright install-deps chromium      (Linux/Codespaces only)

COMPLIANCE NOTE: This output is AI-assisted. Per policy, a qualified person
must review it before it's used in any grant or funding decision. Rows
where data could not be confirmed are flagged rather than guessed.
"""

import re
import time
import requests
import pandas as pd
from bs4 import BeautifulSoup
from playwright.sync_api import sync_playwright
from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill, Alignment
from openpyxl.utils import get_column_letter

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

INPUT_FILE = "Quarterly Grantee Tax-Exempt Check.xlsx"  # needs: Organization Name, EIN, 2026 Budget
OUTPUT_FILE = "Grant_Compliance_Analysis.xlsx"

ORG_PAGE_URL = "https://projects.propublica.org/nonprofits/organizations/{ein}"
FULL_FILING_URL = "https://projects.propublica.org/nonprofits/organizations/{ein}/{object_id}/full"

REQUEST_DELAY_SECONDS = 1.0
HEADERS = {"User-Agent": "Mozilla/5.0 (compatible; GranteeCheckBot/1.0)"}

RULE1_THRESHOLD = 0.35   # Grant / Revenue
RULE2_THRESHOLD = 75.0   # Public Support Percentage minimum
RULE3_THRESHOLD = 0.50   # Public Support / Grant Budget

HEADER_FILL = PatternFill(start_color="D9E1F2", end_color="D9E1F2", fill_type="solid")
RED_FILL = PatternFill(start_color="FFC7CE", end_color="FFC7CE", fill_type="solid")
YELLOW_FILL = PatternFill(start_color="FFEB9C", end_color="FFEB9C", fill_type="solid")
PURPLE_FILL = PatternFill(start_color="E4DFEC", end_color="E4DFEC", fill_type="solid")
GREY_FILL = PatternFill(start_color="D9D9D9", end_color="D9D9D9", fill_type="solid")
GREEN_FILL = PatternFill(start_color="C6EFCE", end_color="C6EFCE", fill_type="solid")

COLUMNS = {
    "A": "Organization Name",
    "B": "Form 990 Year Used",
    "C": "Portfolio Strategy",          # blank -- manual entry
    "D": "2026 Grant Budget",
    "E": "EIN",
    "F": "Filing Link",
    "G": "Total Revenue (Form 990)",
    "H": "Public Support Amount",
    "I": "Grant / Revenue (D/G)",
    "J": "Rule 1 Flag (>35%)",
    "K": "Rule 2 Flag (Public Support <75%)",
    "L": "Public Support Percentage",
    "M": "Rule 3 Flag (Support/Grant >50%)",
    "N": "Public Support / Grant Budget (H/D)",
    "O": "Overall Status",
    "P": "Notes",
}
COL_LETTERS = list(COLUMNS.keys())
COL_WIDTHS = {"A": 28, "B": 12, "C": 18, "D": 14, "E": 13, "F": 38, "G": 14, "H": 14,
              "I": 12, "J": 10, "K": 10, "L": 12, "M": 10, "N": 12, "O": 22, "P": 45}


# ---------------------------------------------------------------------------
# Step 1-3: org page (plain HTTP, no browser needed) -- Revenue, Year, filing link
# ---------------------------------------------------------------------------

def fetch_org_summary(ein):
    result = {"propublica_name": None, "object_id": None, "year": None, "total_revenue": None, "notes": ""}

    url = ORG_PAGE_URL.format(ein=ein)
    try:
        resp = requests.get(url, headers=HEADERS, timeout=20)
    except requests.RequestException as e:
        result["notes"] = f"Request to org page failed: {e}"
        return result

    if resp.status_code != 200:
        result["notes"] = f"Org page returned status {resp.status_code}"
        return result

    matches = re.findall(rf"organizations/{ein}/(\d{{15,20}})/full", resp.text)
    if not matches:
        result["notes"] = "No filing links found on the org's page (org may not e-file, or has no digitized filings)."
        return result
    result["object_id"] = max(matches, key=lambda x: int(x))

    soup = BeautifulSoup(resp.text, "html.parser")
    text = soup.get_text("\n")

    h1 = soup.find("h1")
    if h1:
        result["propublica_name"] = h1.get_text(strip=True)

    year_match = re.search(r"Fiscal Year Ending[^\n]*\n\s*(\d{4})", text)
    if year_match:
        result["year"] = year_match.group(1)

    search_start = year_match.start() if year_match else 0
    revenue_match = re.search(r"Revenue\s*\n?\s*\$([\d,]+)", text[search_start:])
    if revenue_match:
        result["total_revenue"] = float(revenue_match.group(1).replace(",", ""))
    else:
        result["notes"] += "Could not find a Revenue figure near the most recent filing card. "

    return result


# ---------------------------------------------------------------------------
# Step 4-5: Schedule A (requires a real browser -- this part is JS-rendered)
# ---------------------------------------------------------------------------

def extract_schedule_a(page, ein, object_id):
    result = {"public_support": None, "total_support": None, "public_support_pct": None, "notes": ""}

    url = FULL_FILING_URL.format(ein=ein, object_id=object_id)
    page.goto(url, timeout=30000, wait_until="domcontentloaded")

    all_dropdowns = page.locator("select").all()
    schedule_dropdown = None
    schedule_options = []
    for candidate in all_dropdowns:
        try:
            candidate_options = candidate.locator("option").all_inner_texts()
        except Exception:
            continue
        if any("schedule a" in o.lower() for o in candidate_options):
            schedule_dropdown = candidate
            schedule_options = candidate_options
            break

    if schedule_dropdown is None:
        result["notes"] = "No dropdown containing a 'Schedule A' option was found on the Full Filing page."
        return result

    schedule_a_label = next(o for o in schedule_options if "schedule a" in o.lower())
    schedule_dropdown.select_option(label=schedule_a_label)
    page.wait_for_timeout(3000)

    # The actual tax-document content renders inside separate IFRAMEs, one
    # per schedule, each served from a signed S3 URL containing the schedule
    # name. Match on that URL pattern directly.
    visible_text = page.inner_text("body")
    schedule_a_frame = None
    for frame in page.frames:
        if re.search(r"ScheduleA_\d+\.html", frame.url):
            schedule_a_frame = frame
            break

    if schedule_a_frame is None:
        result["notes"] = "Could not find an iframe whose URL matches the Schedule A pattern."
        return result

    try:
        visible_text = schedule_a_frame.inner_text("body")
    except Exception as e:
        result["notes"] = f"Found the Schedule A frame but could not read its text: {e}"
        return result

    def find_first(pattern):
        match = re.search(pattern, visible_text, re.IGNORECASE | re.DOTALL)
        return float(match.group(1).replace(",", "")) if match else None

    result["public_support"] = find_first(r"\b6\s+Public support\. Subtract line 5 from line 4\.\s*([\d,]{4,})")
    result["total_support"] = find_first(r"\b11\s+Total support\. Add lines 7 through 10\s*([\d,]{4,})")

    # Require the exact Part II wording so we can't accidentally match Part
    # III's different percentage (a confirmed prior source of wrong values).
    pct_match = re.search(
        r"public support percentage for \d{4}\s*\(line 6,?\s*column\s*\(f\)\s*divided by line 11,?\s*column\s*\(f\)\)"
        r".{0,100}?([\d.]+)\s*%",
        visible_text, re.IGNORECASE | re.DOTALL,
    )
    candidate_pct = float(pct_match.group(1)) if pct_match else None

    if candidate_pct is not None and result["public_support"] and result["total_support"] and result["total_support"] > 0:
        computed_pct = (result["public_support"] / result["total_support"]) * 100
        if abs(candidate_pct - computed_pct) > 1.0:
            result["notes"] += (
                f"Matched percentage ({candidate_pct}%) did not match Line 6/Line 11 ratio "
                f"({computed_pct:.2f}%) -- discarding the mismatched value rather than guessing. "
            )
            candidate_pct = None

    if candidate_pct is not None:
        result["public_support_pct"] = candidate_pct
    elif result["public_support"] and result["total_support"] and result["total_support"] > 0:
        result["public_support_pct"] = (result["public_support"] / result["total_support"]) * 100
        result["notes"] += "Percentage computed from Line 6 / Line 11 (pre-calculated % text not matched on page). "
    else:
        result["public_support_pct"] = None

    if result["public_support_pct"] is None:
        result["notes"] += "Could not confirm Public Support Percentage -- left blank rather than guess. "
        try:
            debug_filename = f"debug_failed_{ein}.txt"
            with open(debug_filename, "w") as f:
                f.write(visible_text)
            result["notes"] += f"Full page text saved to {debug_filename} for review. "
        except Exception:
            pass

    return result


# ---------------------------------------------------------------------------
# Per-org pipeline: pull 990 data AND apply Rule 1-3 in one pass
# ---------------------------------------------------------------------------

def process_org(ein, org_name, grant_budget, browser):
    ein = "".join(ch for ch in str(ein) if ch.isdigit())

    row = {letter: "" for letter in COL_LETTERS}
    row["A"] = org_name
    row["C"] = ""  # Portfolio Strategy -- blank, manual entry
    row["D"] = grant_budget
    row["E"] = ein
    row["F"] = ORG_PAGE_URL.format(ein=ein)

    notes = []

    summary = fetch_org_summary(ein)
    row["B"] = summary["year"]
    row["G"] = summary["total_revenue"]
    if summary["notes"]:
        notes.append(summary["notes"])

    if summary["propublica_name"] and org_name and summary["propublica_name"].strip().lower() != str(org_name).strip().lower():
        notes.append(f"Name differs from tracker (tracker: '{org_name}', ProPublica: '{summary['propublica_name']}') -- EIN match used, expected. ")

    public_support = None
    public_support_pct = None

    if summary["object_id"]:
        row["F"] = FULL_FILING_URL.format(ein=ein, object_id=summary["object_id"])
        page = browser.new_page()
        try:
            sched_a = extract_schedule_a(page, ein, summary["object_id"])
        finally:
            page.close()
        public_support = sched_a["public_support"]
        public_support_pct = sched_a["public_support_pct"]
        if sched_a["notes"]:
            notes.append(sched_a["notes"])
    else:
        notes.append("Could not find a filing to check Schedule A.")

    row["H"] = public_support
    row["L"] = public_support_pct

    # ---- Rule 1: Grant / Revenue -- >=35% = Review (yellow), <35% = Pass (green) ----
    revenue = summary["total_revenue"]
    grant_revenue_ratio = None
    rule1_flag = None
    if pd.notna(grant_budget) and revenue and revenue > 0:
        grant_revenue_ratio = grant_budget / revenue
        rule1_flag = "Review" if grant_revenue_ratio >= RULE1_THRESHOLD else "Pass"
    row["I"] = grant_revenue_ratio
    row["J"] = rule1_flag

    # ---- Rule 2: Public Support % -- <75% = Review (yellow), 0% = No Data (purple),
    #      else Pass (green) ----
    rule2_flag = None
    if public_support_pct is not None:
        if public_support_pct == 0:
            rule2_flag = "No Data (0%)"
        elif public_support_pct < RULE2_THRESHOLD:
            rule2_flag = "Review"
        else:
            rule2_flag = "Pass"
    row["K"] = rule2_flag

    # ---- Rule 3: Public Support / Grant Budget -- >50% = Yes (green), else No (yellow) ----
    support_budget_ratio = None
    rule3_flag = None
    if pd.notna(grant_budget) and grant_budget > 0 and public_support:
        support_budget_ratio = public_support / grant_budget
        rule3_flag = "Yes" if support_budget_ratio > RULE3_THRESHOLD else "No"
    row["M"] = rule3_flag
    row["N"] = support_budget_ratio

    # ---- Overall status (Rule 1 is primary, per policy) ----
    if rule1_flag is None:
        status = "NEEDS DATA"
        notes.append("Missing Total Revenue -- Rule 1 could not be evaluated.")
    elif rule1_flag == "Review":
        status = "Needs Legal Review (Rule 1)"
    elif rule2_flag in ("Review", "No Data (0%)") or rule3_flag == "No":
        status = "Additional Review (Rule 2/3)"
    else:
        status = "OK"
    row["O"] = status
    row["P"] = "; ".join(notes)

    return row


def run(org_list):
    """org_list: list of (org_name, ein, grant_budget) tuples."""
    rows = []
    with sync_playwright() as p:
        browser = p.chromium.launch(headless=True)
        for i, (name, ein, budget) in enumerate(org_list):
            print(f"[{i+1}/{len(org_list)}] {name} (EIN {ein})...")
            row = process_org(ein, name, budget, browser)
            rows.append(row)
            print(f"    -> year={row['B']}, revenue={row['G']}, support%={row['L']}, status={row['O']}")
            time.sleep(REQUEST_DELAY_SECONDS)
        browser.close()
    return rows


# ---------------------------------------------------------------------------
# Excel output
# ---------------------------------------------------------------------------

def write_formatted_excel(rows, output_xlsx=OUTPUT_FILE):
    wb = Workbook()
    ws = wb.active
    ws.title = "Grant Compliance Analysis"

    for idx, letter in enumerate(COL_LETTERS, start=1):
        cell = ws.cell(row=1, column=idx, value=COLUMNS[letter])
        cell.font = Font(bold=True)
        cell.fill = HEADER_FILL
        cell.alignment = Alignment(wrap_text=True, vertical="center")

    for row_idx, row in enumerate(rows, start=2):
        for col_idx, letter in enumerate(COL_LETTERS, start=1):
            val = row.get(letter, "")
            cell = ws.cell(row=row_idx, column=col_idx, value=val)
            cell.alignment = Alignment(wrap_text=True, vertical="top")
            if letter in ("I", "N") and isinstance(val, (int, float)):
                cell.number_format = "0.0%"
            if letter == "L" and isinstance(val, (int, float)):
                cell.number_format = "0.00"
            if letter in ("D", "G", "H") and isinstance(val, (int, float)):
                cell.number_format = "#,##0"

        # ---- Rule 1 cells (I = ratio, J = flag): yellow if Review, green if Pass ----
        rule1_flag = row.get("J")
        if rule1_flag == "Review":
            ws.cell(row=row_idx, column=COL_LETTERS.index("I") + 1).fill = YELLOW_FILL
            ws.cell(row=row_idx, column=COL_LETTERS.index("J") + 1).fill = YELLOW_FILL
        elif rule1_flag == "Pass":
            ws.cell(row=row_idx, column=COL_LETTERS.index("I") + 1).fill = GREEN_FILL
            ws.cell(row=row_idx, column=COL_LETTERS.index("J") + 1).fill = GREEN_FILL

        # ---- Rule 2 cells (K = flag/review words, L = percentage): yellow if
        #      Review, purple if exactly 0% (no real data), green if Pass ----
        rule2_flag = row.get("K")
        if rule2_flag == "No Data (0%)":
            ws.cell(row=row_idx, column=COL_LETTERS.index("K") + 1).fill = PURPLE_FILL
            ws.cell(row=row_idx, column=COL_LETTERS.index("L") + 1).fill = PURPLE_FILL
        elif rule2_flag == "Review":
            ws.cell(row=row_idx, column=COL_LETTERS.index("K") + 1).fill = YELLOW_FILL
            ws.cell(row=row_idx, column=COL_LETTERS.index("L") + 1).fill = YELLOW_FILL
        elif rule2_flag == "Pass":
            ws.cell(row=row_idx, column=COL_LETTERS.index("K") + 1).fill = GREEN_FILL
            ws.cell(row=row_idx, column=COL_LETTERS.index("L") + 1).fill = GREEN_FILL

        # ---- Rule 3 cells (M = Yes/No, N = ratio): green if Yes, yellow if No ----
        rule3_flag = row.get("M")
        if rule3_flag == "Yes":
            ws.cell(row=row_idx, column=COL_LETTERS.index("M") + 1).fill = GREEN_FILL
            ws.cell(row=row_idx, column=COL_LETTERS.index("N") + 1).fill = GREEN_FILL
        elif rule3_flag == "No":
            ws.cell(row=row_idx, column=COL_LETTERS.index("M") + 1).fill = YELLOW_FILL
            ws.cell(row=row_idx, column=COL_LETTERS.index("N") + 1).fill = YELLOW_FILL

        status_cell = ws.cell(row=row_idx, column=COL_LETTERS.index("O") + 1)
        status = row.get("O")
        if status == "NEEDS DATA":
            status_cell.fill = GREY_FILL
        elif status == "Needs Legal Review (Rule 1)":
            status_cell.fill = RED_FILL
        elif status == "Additional Review (Rule 2/3)":
            status_cell.fill = YELLOW_FILL
        elif status == "OK":
            status_cell.fill = GREEN_FILL

    for idx, letter in enumerate(COL_LETTERS, start=1):
        ws.column_dimensions[get_column_letter(idx)].width = COL_WIDTHS.get(letter, 15)
    ws.freeze_panes = "A2"
    wb.save(output_xlsx)
    print(f"\nSaved {output_xlsx}")
    return output_xlsx


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

if __name__ == "__main__":
    from datetime import datetime
    start_time = datetime.now()
    print(f"Run started: {start_time.strftime('%Y-%m-%d %H:%M:%S')}")

    df = pd.read_excel(INPUT_FILE)
    org_names = df.iloc[:, 0].tolist()
    eins = df.iloc[:, 1].tolist()
    budgets = df.iloc[:, 2].tolist()  # "2026 Budget" column
    org_list = list(zip(org_names, eins, budgets))
    print(f"Loaded {len(org_list)} organizations from {INPUT_FILE}")

    rows = run(org_list)
    write_formatted_excel(rows)

    status_counts = {}
    for r in rows:
        status_counts[r["O"]] = status_counts.get(r["O"], 0) + 1
    end_time = datetime.now()
    print(f"\nRun finished: {end_time.strftime('%Y-%m-%d %H:%M:%S')} (took {end_time - start_time})")
    print("Status breakdown:")
    for status, count in status_counts.items():
        print(f"  {status}: {count}")
    print("\nReminder: this output is AI-assisted -- have a qualified person review it before "
          "it's used in any grant decision, and spot-check flagged rows against the actual filing.")