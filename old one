"""
GRANTEE 990 PUBLIC SUPPORT CHECK -- complete pipeline

For every organization in "Quarterly Grantee Tax-Exempt Check.xlsx", this:
  1. Opens the org's page on https://projects.propublica.org/nonprofits/
  2. Finds the most recent Form 990 filing
  3. Pulls Total Revenue and the filing year (from the org page itself --
     this part is plain HTML, no browser automation needed)
  4. Opens that filing's "Full Filing" reconstructed-document view, switches
     the on-page dropdown to "Form 990, Schedule A" (this part requires a
     real headless browser, because that page fills in its numbers with
     JavaScript after loading -- a plain HTTP request only gets an empty
     shell)
  5. Reads Total Public Support and Public Support Percentage from Schedule A
  6. Writes a formatted Excel report with all of it

OUTPUT COLUMNS:
    Organization Name | EIN | Most Recent Filing Year | Total Revenue |
    Total Public Support | Public Support Percentage | 33.33% Threshold |
    Link to Report | Notes

FORMATTING:
    - Wrapped text on every column
    - Bold header row
    - "33.33% Threshold" cell: RED if Public Support Percentage < 33.33,
      GREEN if >= 33.33, left uncolored (with explanation in Notes) if the
      percentage could not be determined for that org

SETUP (run once per environment):
    pip install -r requirements.txt
    playwright install chromium
    playwright install-deps chromium      (Linux only, e.g. Codespaces --
                                            installs system graphics libs
                                            Chromium needs to actually launch)

COMPLIANCE NOTE: This output is AI-assisted. Per policy, a qualified person
must review it before it's used in any grant or funding decision. Rows where
data could not be confirmed are flagged in Notes rather than guessed.
"""

import re
import time
import requests
import pandas as pd
from bs4 import BeautifulSoup
from playwright.sync_api import sync_playwright
from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill, Alignment
from openpyxl.utils import get_column_letter

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

INPUT_FILE = "Quarterly Grantee Tax-Exempt Check.xlsx"
OUTPUT_FILE = "990_public_support_results.xlsx"

ORG_PAGE_URL = "https://projects.propublica.org/nonprofits/organizations/{ein}"
FULL_FILING_URL = "https://projects.propublica.org/nonprofits/organizations/{ein}/{object_id}/full"

REQUEST_DELAY_SECONDS = 1.0
HEADERS = {"User-Agent": "Mozilla/5.0 (compatible; GranteeCheckBot/1.0)"}

RED_FILL = PatternFill(start_color="FFC7CE", end_color="FFC7CE", fill_type="solid")
GREEN_FILL = PatternFill(start_color="C6EFCE", end_color="C6EFCE", fill_type="solid")
HEADER_FILL = PatternFill(start_color="D9E1F2", end_color="D9E1F2", fill_type="solid")

COLUMNS = [
    "Organization Name (Tracker)", "Organization Name (ProPublica)", "EIN",
    "Most Recent Filing Year", "Total Revenue", "Total Public Support",
    "Public Support Percentage", "33.33% Threshold", "Link to Report", "Notes",
]
COLUMN_WIDTHS = {
    "Organization Name (Tracker)": 28, "Organization Name (ProPublica)": 28,
    "EIN": 14, "Most Recent Filing Year": 14,
    "Total Revenue": 16, "Total Public Support": 18,
    "Public Support Percentage": 16, "33.33% Threshold": 16,
    "Link to Report": 42, "Notes": 55,
}


# ---------------------------------------------------------------------------
# Step 1-3: org page (plain HTTP, no browser needed) -- Revenue, Year, filing link
# ---------------------------------------------------------------------------

def fetch_org_summary(ein):
    """
    Fetches the org's ProPublica page and pulls:
      - the org's official name as ProPublica has it on file (useful to
        cross-check against the name in your tracker, since org names can
        drift/differ while the EIN stays the same and authoritative)
      - the most recent filing's object ID (from the ".../{object_id}/full" link)
      - that filing's fiscal year
      - that filing's Total Revenue
    All lookups are keyed ONLY by EIN -- the organization name from your
    tracker file is never sent to ProPublica or used to search; it's only
    carried through to the output for your reference.

    Returns a dict; missing pieces are None with an explanation in "notes".
    """
    result = {"propublica_name": None, "object_id": None, "year": None, "total_revenue": None, "notes": ""}

    url = ORG_PAGE_URL.format(ein=ein)
    try:
        resp = requests.get(url, headers=HEADERS, timeout=20)
    except requests.RequestException as e:
        result["notes"] = f"Request to org page failed: {e}"
        return result

    if resp.status_code != 200:
        result["notes"] = f"Org page returned status {resp.status_code}"
        return result

    # Most recent filing's object ID: object IDs start with the year received
    # (e.g. 2026...), so the numerically largest match = most recent filing
    matches = re.findall(rf"organizations/{ein}/(\d{{15,20}})/full", resp.text)
    if not matches:
        result["notes"] = "No filing links found on the org's page (org may not e-file, or has no digitized filings)."
        return result
    result["object_id"] = max(matches, key=lambda x: int(x))

    # Parse the visible text (BeautifulSoup strips tags) for the first
    # "Fiscal Year Ending ... YYYY" block and its Revenue figure -- these
    # cards are listed most-recent-first on the page.
    soup = BeautifulSoup(resp.text, "html.parser")
    text = soup.get_text("\n")

    # ProPublica's own name for this EIN -- typically the first <h1> on the
    # page. Captured for cross-checking against your tracker's name column.
    h1 = soup.find("h1")
    if h1:
        result["propublica_name"] = h1.get_text(strip=True)

    year_match = re.search(r"Fiscal Year Ending[^\n]*\n\s*(\d{4})", text)
    if year_match:
        result["year"] = year_match.group(1)

    # Look for a "Revenue" label followed by a dollar figure, searched from
    # the position of the first "Fiscal Year Ending" block onward so we
    # don't accidentally grab a number from later (older) filing cards.
    search_start = year_match.start() if year_match else 0
    revenue_match = re.search(r"Revenue\s*\n?\s*\$([\d,]+)", text[search_start:])
    if revenue_match:
        result["total_revenue"] = float(revenue_match.group(1).replace(",", ""))
    else:
        result["notes"] += "Could not find a Revenue figure near the most recent filing card. "

    return result


# ---------------------------------------------------------------------------
# Step 4-5: Schedule A (requires a real browser -- this part is JS-rendered)
# ---------------------------------------------------------------------------

def extract_schedule_a(page, ein, object_id):
    """
    Loads the "Full Filing" reconstructed-document page, switches the
    on-page dropdown to "Form 990, Schedule A", and reads the rendered
    Public Support / Total Support / Public Support Percentage figures.
    """
    result = {"public_support": None, "total_support": None, "public_support_pct": None, "notes": ""}

    url = FULL_FILING_URL.format(ein=ein, object_id=object_id)
    page.goto(url, timeout=30000, wait_until="domcontentloaded")

    # There are multiple <select> dropdowns on this page (e.g. the site's
    # search-category filter). Find the ONE that actually contains a
    # "Schedule A" option, rather than assuming it's the first dropdown.
    all_dropdowns = page.locator("select").all()
    schedule_dropdown = None
    schedule_options = []
    for candidate in all_dropdowns:
        try:
            candidate_options = candidate.locator("option").all_inner_texts()
        except Exception:
            continue
        if any("schedule a" in o.lower() for o in candidate_options):
            schedule_dropdown = candidate
            schedule_options = candidate_options
            break

    if schedule_dropdown is None:
        result["notes"] = "No dropdown containing a 'Schedule A' option was found on the Full Filing page."
        return result, page.inner_text("body")

    schedule_a_label = next(o for o in schedule_options if "schedule a" in o.lower())
    schedule_dropdown.select_option(label=schedule_a_label)
    page.wait_for_timeout(3000)  # let the client-side render finish

    # The actual tax-document content renders inside separate IFRAMEs, one
    # per schedule, each served from a signed S3 URL containing the schedule
    # name (e.g. ".../202601059349302210_IRS990ScheduleA_0.html"). Match on
    # that URL pattern directly -- far more reliable than guessing from text
    # content, since multiple schedules can mention "Schedule A" in passing.
    visible_text = page.inner_text("body")  # fallback if no matching frame found
    schedule_a_frame = None
    for frame in page.frames:
        if re.search(r"ScheduleA_\d+\.html", frame.url):
            schedule_a_frame = frame
            break

    if schedule_a_frame is None:
        result["notes"] = "Could not find an iframe whose URL matches the Schedule A pattern."
        return result, visible_text

    try:
        visible_text = schedule_a_frame.inner_text("body")
    except Exception as e:
        result["notes"] = f"Found the Schedule A frame but could not read its text: {e}"
        return result, visible_text

    def find_first(pattern):
        match = re.search(pattern, visible_text, re.IGNORECASE | re.DOTALL)
        return float(match.group(1).replace(",", "")) if match else None

    # Anchor on the EXACT distinctive instruction text next to each line,
    # not just the word "public support" (which also appears in the section
    # header and in "Public support percentage", causing false matches).
    # Widened gap tolerance (.{0,150}) since exact whitespace/blank-cell
    # layout varies by org and by how many prior years' columns are filled.
    result["public_support"] = find_first(r"\b6\s+Public support\. Subtract line 5 from line 4\.\s*([\d,]{4,})")

    # Line 11: "Total support. Add lines 7 through 10" <value>
    result["total_support"] = find_first(r"\b11\s+Total support\. Add lines 7 through 10\s*([\d,]{4,})")

    # Line 14: "Public support percentage for <year> (line 6, column (f)
    # divided by line 11, column (f))" <value> %
    pct_match = re.search(
        r"public support percentage for \d{4}.{0,200}?([\d.]+)\s*%",
        visible_text, re.IGNORECASE | re.DOTALL,
    )
    if pct_match:
        result["public_support_pct"] = float(pct_match.group(1))
    elif result["public_support"] and result["total_support"] and result["total_support"] > 0:
        result["public_support_pct"] = (result["public_support"] / result["total_support"]) * 100
        result["notes"] += "Percentage computed from Public Support / Total Support (pre-calculated % text not matched on page). "

    if result["public_support_pct"] is None:
        result["notes"] += "Could not extract Public Support Percentage from the rendered Schedule A page. "
        # Save the actual page text so we can see exactly what's there
        # instead of guessing at the regex again.
        try:
            debug_filename = f"debug_failed_{ein}.txt"
            with open(debug_filename, "w") as f:
                f.write(visible_text)
            result["notes"] += f"Full page text saved to {debug_filename} for review. "
        except Exception:
            pass

    return result, visible_text


# ---------------------------------------------------------------------------
# Per-org pipeline
# ---------------------------------------------------------------------------

def process_org(ein, org_name, browser):
    ein = "".join(ch for ch in str(ein) if ch.isdigit())
    row = {
        "Organization Name (Tracker)": org_name, "Organization Name (ProPublica)": None,
        "EIN": ein, "Most Recent Filing Year": None,
        "Total Revenue": None, "Total Public Support": None,
        "Public Support Percentage": None, "33.33% Threshold": "",
        "Link to Report": ORG_PAGE_URL.format(ein=ein), "Notes": "",
    }

    summary = fetch_org_summary(ein)
    row["Organization Name (ProPublica)"] = summary["propublica_name"]
    row["Most Recent Filing Year"] = summary["year"]
    row["Total Revenue"] = summary["total_revenue"]
    row["Notes"] += summary["notes"]

    if summary["propublica_name"] and org_name and summary["propublica_name"].strip().lower() != str(org_name).strip().lower():
        row["Notes"] += f"Name differs from tracker (tracker: '{org_name}', ProPublica: '{summary['propublica_name']}') -- EIN match used, this is expected and not an error. "

    if not summary["object_id"]:
        row["33.33% Threshold"] = "Unknown -- see Notes"
        return row

    row["Link to Report"] = FULL_FILING_URL.format(ein=ein, object_id=summary["object_id"])

    page = browser.new_page()
    try:
        sched_a, _visible_text = extract_schedule_a(page, ein, summary["object_id"])
    finally:
        page.close()

    row["Total Public Support"] = sched_a["public_support"]
    row["Public Support Percentage"] = sched_a["public_support_pct"]
    row["Notes"] += sched_a["notes"]

    if sched_a["public_support_pct"] is not None:
        row["33.33% Threshold"] = "Below 33.33%" if sched_a["public_support_pct"] < 33.33 else "At/Above 33.33%"
    else:
        row["33.33% Threshold"] = "Unknown -- see Notes"

    return row


def run(org_list):
    """org_list: list of (org_name, ein) tuples."""
    rows = []
    with sync_playwright() as p:
        browser = p.chromium.launch(headless=True)
        for i, (name, ein) in enumerate(org_list):
            print(f"[{i+1}/{len(org_list)}] {name} (EIN {ein})...")
            row = process_org(ein, name, browser)
            rows.append(row)
            print(f"    -> year={row['Most Recent Filing Year']}, revenue={row['Total Revenue']}, "
                  f"support%={row['Public Support Percentage']}, notes={row['Notes'][:100]}")
            time.sleep(REQUEST_DELAY_SECONDS)
        browser.close()
    return rows


# ---------------------------------------------------------------------------
# Excel output
# ---------------------------------------------------------------------------

def write_formatted_excel(rows, output_xlsx=OUTPUT_FILE):
    wb = Workbook()
    ws = wb.active
    ws.title = "990 Public Support Check"

    for col_idx, col_name in enumerate(COLUMNS, start=1):
        cell = ws.cell(row=1, column=col_idx, value=col_name)
        cell.font = Font(bold=True)
        cell.fill = HEADER_FILL
        cell.alignment = Alignment(wrap_text=True, vertical="center")

    for row_idx, row in enumerate(rows, start=2):
        for col_idx, col_name in enumerate(COLUMNS, start=1):
            value = row.get(col_name, "")
            cell = ws.cell(row=row_idx, column=col_idx, value=value)
            cell.alignment = Alignment(wrap_text=True, vertical="top")
            if col_name == "Public Support Percentage" and isinstance(value, (int, float)):
                cell.number_format = "0.00"
            if col_name in ("Total Revenue", "Total Public Support") and isinstance(value, (int, float)):
                cell.number_format = "#,##0"

        threshold_cell = ws.cell(row=row_idx, column=COLUMNS.index("33.33% Threshold") + 1)
        pct = row.get("Public Support Percentage")
        if isinstance(pct, (int, float)):
            threshold_cell.fill = RED_FILL if pct < 33.33 else GREEN_FILL

    for col_idx, col_name in enumerate(COLUMNS, start=1):
        ws.column_dimensions[get_column_letter(col_idx)].width = COLUMN_WIDTHS.get(col_name, 20)
    ws.freeze_panes = "A2"
    wb.save(output_xlsx)
    print(f"\nSaved {output_xlsx}")
    return output_xlsx


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

if __name__ == "__main__":
    df = pd.read_excel(INPUT_FILE)
    org_names = df.iloc[:, 0].tolist()
    eins = df.iloc[:, 1].tolist()
    org_list = list(zip(org_names, eins))
    print(f"Loaded {len(org_list)} organizations from {INPUT_FILE}")

    rows = run(org_list)
    write_formatted_excel(rows)

    ok = sum(1 for r in rows if isinstance(r.get("Public Support Percentage"), (int, float)))
    print(f"\n{ok}/{len(rows)} orgs got a Public Support Percentage successfully.")
    print("Reminder: this output is AI-assisted -- have a qualified person review it before "
          "it's used in any grant decision, and spot-check flagged rows against the actual filing.")