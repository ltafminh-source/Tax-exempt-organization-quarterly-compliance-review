import re
import time
import requests
import pandas as pd
import xml.etree.ElementTree as ET
from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill, Alignment
from openpyxl.utils import get_column_letter

ORG_PAGE_URL = "https://projects.propublica.org/nonprofits/organizations/{ein}"
ORG_API_URL = "https://projects.propublica.org/nonprofits/api/v2/organizations/{ein}.json"
S3_XML_URL = "https://s3.amazonaws.com/irs-form-990/{object_id}_public.xml" # Kept as fallback/reference

REQUEST_DELAY_SECONDS = 1.0

RED_FILL = PatternFill(start_color="FFC7CE", end_color="FFC7CE", fill_type="solid")
GREEN_FILL = PatternFill(start_color="C6EFCE", end_color="C6EFCE", fill_type="solid")
HEADER_FILL = PatternFill(start_color="D9E1F2", end_color="D9E1F2", fill_type="solid")

HEADERS = {"User-Agent": "Mozilla/5.0 (compatible; GranteeCheckBot/1.0)"}


# ---------------- Step 1-2: find the most recent filing's XML data URL ----------------

def find_most_recent_filing_data_url(ein):
    """
    Fetches the organization data from ProPublica's API and finds the XML URL
    of the most recent filing that has an associated XML or object ID.
    Also returns the ProPublica organization page URL.

    Returns (xml_data_url, page_url, error_message) or (None, page_url, error_message).
    """
    api_url = ORG_API_URL.format(ein=ein)
    page_url = ORG_PAGE_URL.format(ein=ein)

    resp = requests.get(api_url, headers=HEADERS, timeout=20)
    if resp.status_code != 200:
        return None, page_url, f"ProPublica API returned {resp.status_code} for EIN {ein}"

    org_json = resp.json()
    filings = org_json.get("filings_with_data", [])
    if not filings:
        return None, page_url, "No digitized filings available for this EIN in ProPublica API."

    # Sort filings by tax_prd_yr in descending order
    sorted_filings = sorted(filings, key=lambda f: f.get("tax_prd_yr", 0), reverse=True)

    xml_data_url = None
    error_message = "No filing with an xml_url or object_id found among digitized filings in ProPublica API."

    # Iterate through sorted filings to find the most recent one with XML data
    for filing in sorted_filings:
        xml_data_url = filing.get("xml_url")
        if xml_data_url:
            return xml_data_url, page_url, None # Found a valid XML URL

        object_id = filing.get("object_id")
        if object_id:
            xml_data_url = S3_XML_URL.format(object_id=object_id)
            return xml_data_url, page_url, None # Found a valid object_id

    # If loop finishes, no suitable filing was found
    return None, page_url, error_message


# ---------------- Step 3: pull the real IRS XML ----------------

def fetch_filing_xml(xml_data_url):
    """
    Fetches the XML content from the given URL.
    """
    resp = requests.get(xml_data_url, timeout=30)
    if resp.status_code != 200:
        return None, f"S3 returned {resp.status_code} for URL {xml_data_url}"
    try:
        root = ET.fromstring(resp.content)
    except ET.ParseError as e:
        return None, f"XML parse error for URL {xml_data_url}: {e}"
    return root, None


# ---------------- Step 4: read Schedule A + core financials from the XML ----------------

def _find_text(root, tag_suffix):
    """Finds the first element anywhere in the tree whose tag (ignoring XML
    namespace prefix) ends with tag_suffix, and returns its text as a float,
    or None if not found / not numeric."""
    for elem in root.iter():
        tag = elem.tag.split("}")[-1]
        if tag == tag_suffix and elem.text:
            try:
                return float(elem.text.strip())
            except ValueError:
                return None
    return None


def _find_tax_year(root):
    for tag_suffix in ("TaxYr", "TaxPeriodEndDt"):
        for elem in root.iter():
            tag = elem.tag.split("}")[-1]
            if tag == tag_suffix and elem.text:
                return elem.text.strip()
    return ""


def extract_financials(root):
    """
    Pulls Total Revenue plus Schedule A Part II figures from the XML using
    the IRS's own standard element names. Some of these names vary slightly
    by form version/year -- we try the most common variants.
    """
    result = {
        "total_revenue": None,
        "public_support": None,       # Sched A Part II Line 6
        "total_support": None,        # Sched A Part II Line 11
        "public_support_pct": None,   # Sched A Part II Line 14
        "tax_year": _find_tax_year(root),
        "raw_notes": "",
    }

    # Total revenue -- try a couple of known element names
    for tag in ("CYTotalRevenueAmt", "TotalRevenueAmt", "TotalRevenueCurrentYear"):
        val = _find_text(root, tag)
        if val is not None:
            result["total_revenue"] = val
            break

    # Schedule A Part II -- element names per the IRS 990 Schedule A schema.
    # Line 6 (Public support)
    for tag in ("PublicSupportAmt", "TotalSupportAmt6", "Total170SupportAmt"):
        val = _find_text(root, tag)
        if val is not None:
            result["public_support"] = val
            break

    # Line 11 (Total support)
    for tag in ("TotalSupportAmt", "SupportTotalAmt", "TotalSupportColumn"):
        val = _find_text(root, tag)
        if val is not None:
            result["total_support"] = val
            break

    # Line 14 (Public support percentage) -- IRS stores this as a decimal
    # (e.g. 0.4523 = 45.23%), not already multiplied by 100
    for tag in ("PublicSupportPct", "PublicSupportPercentage"):
        val = _find_text(root, tag)
        if val is not None:
            result["public_support_pct"] = val * 100  # convert to a normal percentage
            break

    if result["public_support_pct"] is None and result["public_support"] is not None and result["total_support"] is not None:
        # Fall back to computing it ourselves if the pre-calculated field wasn't found
        if result["total_support"] > 0:
            result["public_support_pct"] = (result["public_support"] / result["total_support"]) * 100
            result["raw_notes"] += "Percentage computed from Line 6 / Line 11 (pre-calculated Line 14 field not found in XML). "

    if result["public_support"] is None or result["total_support"] is None:
        result["raw_notes"] += (
            "Could not find standard Schedule A Line 6 / Line 11 element names in this "
            "XML -- form version may use different tags, or this org filed under a "
            "different public charity test (e.g. 509(a)(2), Schedule A Part III instead "
            "of Part II). Manual check recommended (see SOP doc). "
        )

    return result


# ---------------- Full per-org pipeline ----------------

def process_org(ein, org_name):
    ein = "".join(ch for ch in str(ein) if ch.isdigit())
    result = {
        "Company Name": org_name,
        "EIN": ein,
        "Most Recent Filing Year": "",
        "Total Revenue": None,
        "Total Public Support": None,
        "Public Support Percentage": None,
        "Below 33.33% Threshold": "",
        "Filing URL": "",
        "Notes": "",
    }

    xml_data_url, page_url, id_err = find_most_recent_filing_data_url(ein) # Call the new function
    result["Filing URL"] = page_url

    if id_err:  # Handle errors from finding object_id
        result["Notes"] = id_err
        return result

    if not xml_data_url: # Check for the data url instead of object_id
        result["Notes"] = "Could not find a valid XML data URL for filing (error from API, not S3)."
        return result

    root, err = fetch_filing_xml(xml_data_url) # Pass the data url
    if err:
        result["Notes"] = f"XML fetch failed for URL {xml_data_url}: {err}"
        return result

    financials = extract_financials(root)
    result["Most Recent Filing Year"] = financials["tax_year"]
    result["Total Revenue"] = financials["total_revenue"]
    result["Total Public Support"] = financials["public_support"]
    result["Public Support Percentage"] = financials["public_support_pct"]
    result["Notes"] = financials["raw_notes"]

    if financials["public_support_pct"] is not None:
        result["Below 33.33% Threshold"] = "Yes" if financials["public_support_pct"] < 33.33 else "No"
    else:
        result["Below 33.33% Threshold"] = "Unknown -- see Notes"

    return result


def run(org_list):
    """org_list: list of (org_name, ein) tuples."""
    rows = []
    for i, (name, ein) in enumerate(org_list):
        print(f"[{i+1}/{len(org_list)}] {name} (EIN {ein})...何度もやってもうまくいかない") # Add a clearer message here
        r = process_org(ein, name)
        rows.append(r)
        # Updated print statement for better clarity and robustness
        support_pct_str = f"{r['Public Support Percentage']:.2f}%" if isinstance(r['Public Support Percentage'], (int, float)) else "None"
        notes_str = r['Notes'][:100] if r['Notes'] else 'None'
        print(f"    -> year={r['Most Recent Filing Year']}, revenue={r['Total Revenue']}, "
              f"support%={support_pct_str}, notes={notes_str}")
        time.sleep(REQUEST_DELAY_SECONDS)
    return rows


# ---------------- Excel formatting (same layout as before) ----------------

COLUMNS = [
    "Company Name", "EIN", "Most Recent Filing Year", "Total Revenue",
    "Total Public Support", "Public Support Percentage",
    "Below 33.33% Threshold", "Filing URL", "Notes",
]
COLUMN_WIDTHS = {
    "Company Name": 30, "EIN": 14, "Most Recent Filing Year": 14,
    "Total Revenue": 16, "Total Public Support": 18,
    "Public Support Percentage": 16, "Below 33.33% Threshold": 18,
    "Filing URL": 42, "Notes": 55,
}


def write_formatted_excel(rows, output_xlsx="990_public_support_results_v2.xlsx"):
    wb = Workbook()
    ws = wb.active
    ws.title = "990 Public Support Check"

    for col_idx, col_name in enumerate(COLUMNS, start=1):
        cell = ws.cell(row=1, column=col_idx, value=col_name)
        cell.font = Font(bold=True)
        cell.fill = HEADER_FILL
        cell.alignment = Alignment(wrap_text=True, vertical="center")

    for row_idx, row in enumerate(rows, start=2):
        for col_idx, col_name in enumerate(COLUMNS, start=1):
            value = row.get(col_name, "")
            cell = ws.cell(row=row_idx, column=col_idx, value=value)
            cell.alignment = Alignment(wrap_text=True, vertical="top")
            if col_name == "Public Support Percentage" and isinstance(value, (int, float)):
                cell.number_format = "0.00%" # Changed to percentage format
            if col_name in ("Total Revenue", "Total Public Support") and isinstance(value, (int, float)):
                cell.number_format = "#,##0"

        threshold_cell = ws.cell(row=row_idx, column=COLUMNS.index("Below 33.33% Threshold") + 1)
        pct = row.get("Public Support Percentage")
        if isinstance(pct, (int, float)):
            threshold_cell.fill = RED_FILL if pct < 33.33 else GREEN_FILL

    for col_idx, col_name in enumerate(COLUMNS, start=1):
        ws.column_dimensions[get_column_letter(col_idx)].width = COLUMN_WIDTHS.get(col_name, 20)
    ws.freeze_panes = "A2"
    wb.save(output_xlsx)
    print(f"\nSaved {output_xlsx}")
    return output_xlsx


if __name__ == "__main__":
    INPUT_FILE = "Quarterly Grantee Tax-Exempt Check.xlsx"
    OUTPUT_FILE = "990_public_support_results_v2.xlsx"

    df = pd.read_excel(INPUT_FILE)
    org_names = df.iloc[:, 0].tolist()   # "Organization Name"
    eins = df.iloc[:, 1].tolist()        # "EIN"
    org_list = list(zip(org_names, eins))

    print(f"Loaded {len(org_list)} organizations from {INPUT_FILE}")

    rows = run(org_list)
    write_formatted_excel(rows, output_xlsx=OUTPUT_FILE)

    ok = sum(1 for r in rows if isinstance(r.get("Public Support Percentage"), (int, float)))
    print(
        f"\n{ok}/{len(rows)} orgs got a Public Support Percentage successfully.\n"
        "Reminder: this pipeline is new and untested at scale -- spot-check a handful of "
        "rows against the actual ProPublica page/PDF before relying on the results, and "
        "per Sheridan Place policy, have a qualified person review this output before it's "
        "used in any grant decision."
    )
